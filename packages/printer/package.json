{
  "name": "@rms/printer",
  "version": "0.0.0",
  "private": true,
  "description": "ESC/POS command builder, print spooler with retry, and a LAN (TCP 9100) transport",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./tcp": { "types": "./dist/tcp.d.ts", "default": "./dist/tcp.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.8.0"
  }
}
