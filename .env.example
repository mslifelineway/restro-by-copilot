# Owner connection: runs migrations/seed (bypasses RLS). Never used by the running API.
DATABASE_OWNER_URL=postgres://rms:rms@localhost:5440/rms
# App connection: non-superuser role subject to RLS. Used by the API.
DATABASE_URL=postgres://rms_app:rms_app@localhost:5440/rms
RMS_APP_DB_PASSWORD=rms_app

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# Express trust-proxy value; set to the proxy hop(s) in production so per-IP rate limits see real clients
TRUST_PROXY=loopback
THROTTLE_DEFAULT_PER_MIN=300
THROTTLE_AUTH_PER_MIN=10
PORT=3100

# Seeded on `pnpm db:seed` (platform super admin)
PLATFORM_ADMIN_EMAIL=admin@rms.local
PLATFORM_ADMIN_PASSWORD=ChangeMe123!

# Email (password reset). console = log + keep in memory (dev only); smtp = real delivery (set SMTP_URL, e.g. smtps://user:pass@email-smtp.region.amazonaws.com)
MAIL_TRANSPORT=console
SMTP_URL=
MAIL_FROM=RMS <no-reply@rms.local>
# Public URL of the admin app (used in reset links)
ADMIN_URL=http://localhost:3001
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=3
